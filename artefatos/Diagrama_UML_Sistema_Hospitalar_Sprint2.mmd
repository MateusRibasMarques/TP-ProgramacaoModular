classDiagram
direction TB

%% MedCore - modelo de domínio extraído do código (pacotes model/ e enums/)

class Paciente {
  -id : Long
  -nome : String
  -cpf : String
  -dataNascimento : LocalDate
  -telefone : String
  -endereco : String
  -email : String
}

class Profissional {
  <<abstract>>
  -id : Long
  -nome : String
  -registroProfissional : String
  -telefone : String
  -email : String
  +validarAtendimento(Atendimento atendimento)* void
}

class MedicoClinicoGeral {
  +validarAtendimento(Atendimento atendimento) void
}

class MedicoEspecialista {
  -especialidade : String
  +validarAtendimento(Atendimento atendimento) void
}

class Cirurgiao {
  -areaAtuacaoCirurgica : String
  +validarAtendimento(Atendimento atendimento) void
}

class Atendimento {
  <<abstract>>
  -id : Long
  -data : LocalDate
  -horario : LocalTime
  -observacoes : String
}

class Consulta {
  <<abstract>>
  -motivo : String
  -situacao : StatusConsulta = AGENDADA
}

class ConsultaRotina

class ConsultaEspecializada {
  -especialidade : String
}

class AtendimentoEmergencia {
  -prioridade : PrioridadeAtendimento
  -situacao : StatusAtendimentoEmergencia = AGUARDANDO_AVALIACAO
  +iniciarAtendimento() void
  +concluirAtendimento() void
}

class ProcedimentoCirurgico {
  -descricao : String
  -tipoCirurgia : String
  -observacoesPreOperatorias : String
  -observacoesPosOperatorias : String
  -dataHoraInicioReal : LocalDateTime
  -dataHoraFimReal : LocalDateTime
  -situacao : StatusProcedimento = AGENDADO
  +iniciarProcedimento() void
  +concluirProcedimento(String observacoesPosOperatorias) void
  +cancelarProcedimento() void
}

class Internacao {
  -id : Long
  -dataEntrada : LocalDate
  -dataPrevistaAlta : LocalDate
  -dataEfetivaAlta : LocalDate
  -observacoes : String
  -status : StatusInternacao = ATIVA
}

class Quarto {
  -id : Long
  -numero : String
  -andar : String
  -capacidadeMaxima : Integer
  -ocupacaoAtual : Integer = 0
  -tipo : TipoQuarto
  -situacao : StatusQuarto = DISPONIVEL
  +isDisponivel() boolean
  +adicionarPaciente() void
  +removerPaciente() void
}

class StatusConsulta {
  <<enumeration>>
  AGENDADA
  CONFIRMADA
  EM_ATENDIMENTO
  CONCLUIDA
  CANCELADA
  NAO_COMPARECEU
}
class StatusAtendimentoEmergencia {
  <<enumeration>>
  AGUARDANDO_AVALIACAO
  EM_ATENDIMENTO
  CONCLUIDO
}
class PrioridadeAtendimento {
  <<enumeration>>
  BAIXA
  MODERADA
  ALTA
  CRITICA
}
class StatusProcedimento {
  <<enumeration>>
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}
class StatusInternacao {
  <<enumeration>>
  ATIVA
  ALTA_REGISTRADA
}
class StatusQuarto {
  <<enumeration>>
  DISPONIVEL
  OCUPADO
}
class TipoQuarto {
  <<enumeration>>
  ENFERMARIA
  APARTAMENTO
  UTI
}

%% Herança
Profissional <|-- MedicoClinicoGeral
Profissional <|-- MedicoEspecialista
Profissional <|-- Cirurgiao
Atendimento <|-- Consulta
Consulta <|-- ConsultaRotina
Consulta <|-- ConsultaEspecializada
Atendimento <|-- AtendimentoEmergencia
Atendimento <|-- ProcedimentoCirurgico

%% Associações @ManyToOne
Atendimento "0..*" --> "1" Paciente : paciente
Atendimento "0..*" --> "1" Profissional : profissionalResponsavel
Internacao "0..*" --> "1" Paciente : paciente
Internacao "0..*" --> "1" Profissional : profissionalResponsavel
Internacao "0..*" --> "1" Quarto : quarto

%% Dependências usadas em validarAtendimento()
MedicoClinicoGeral ..> ConsultaRotina : use
MedicoClinicoGeral ..> AtendimentoEmergencia : use
MedicoEspecialista ..> ConsultaEspecializada : use
Cirurgiao ..> ProcedimentoCirurgico : use

%% Enums
Consulta "0..*" --> "1" StatusConsulta
AtendimentoEmergencia "0..*" --> "1" StatusAtendimentoEmergencia
AtendimentoEmergencia "0..*" --> "1" PrioridadeAtendimento
ProcedimentoCirurgico "0..*" --> "1" StatusProcedimento
Internacao "0..*" --> "1" StatusInternacao
Quarto "0..*" --> "1" StatusQuarto
Quarto "0..*" --> "1" TipoQuarto
