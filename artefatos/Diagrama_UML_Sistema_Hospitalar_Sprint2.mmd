classDiagram
direction TB

%% ===== Interfaces =====
class Validavel {
  <<interface>>
  +validar()* void
}

class Cancelavel {
  <<interface>>
  +cancelar()* void
  +podeCancelar()* boolean
}

%% ===== Pacientes =====
class Paciente {
  -id : Long
  -nome : String
  -cpf : String
  -dataNascimento : LocalDate
  -telefone : String
  -endereco : String
  -email : String
  +calcularIdade() int
  +atualizarContato(String telefone, String email) void
  +getHistorico() Historico
}

class Historico {
  -id : Long
  +adicionarRegistro(RegistroHistorico registro) void
  +listarRegistros() List~RegistroHistorico~
  +listarAtendimentos() List~Atendimento~
  +listarInternacoes() List~Internacao~
}

class RegistroHistorico {
  -id : Long
  -dataRegistro : LocalDateTime
  -tipo : TipoRegistro
  -descricao : String
  -observacao : String
}

%% ===== Profissionais =====
class ProfissionalSaude {
  <<abstract>>
  -id : Long
  -nome : String
  -registroProfissional : String
  -telefone : String
  -email : String
  -ativo : boolean
  +atualizarDados(String telefone, String email) void
  +verificarDisponibilidade(LocalDateTime dataHora) boolean
  +podeRealizar(Atendimento atendimento)* boolean
}

class ClinicoGeral {
  +podeRealizar(Atendimento atendimento) boolean
  +registrarConsulta(ConsultaRotina consulta, String observacoes) void
  +encaminhar(Paciente paciente, Especialidade especialidade, String motivo) Encaminhamento
}

class MedicoEspecialista {
  -especialidade : Especialidade
  +podeRealizar(Atendimento atendimento) boolean
  +atendeEspecialidade(Especialidade especialidade) boolean
}

class Cirurgiao {
  -areaCirurgica : String
  -rqe : String
  +podeRealizar(Atendimento atendimento) boolean
  +registrarProcedimento(ProcedimentoCirurgico procedimento) void
  +listarProcedimentos() List~ProcedimentoCirurgico~
}

class Encaminhamento {
  -id : Long
  -data : LocalDateTime
  -especialidade : Especialidade
  -motivo : String
}

%% ===== Atendimentos =====
class Atendimento {
  <<abstract>>
  -id : Long
  -dataHora : LocalDateTime
  -observacoes : String
  +validar()* void
  +registrarObservacoes(String observacoes) void
}

class Consulta {
  <<abstract>>
  -motivo : String
  -status : StatusConsulta
  +confirmar() void
  +iniciarAtendimento() void
  +concluir(String observacoes) void
  +cancelar() void
  +podeCancelar() boolean
  +registrarAusencia() void
  +remarcar(LocalDateTime novaDataHora) Consulta
  #alterarStatus(StatusConsulta novo) void
}

class ConsultaRotina {
  +validar() void
}

class ConsultaEspecializada {
  -especialidade : Especialidade
  +validar() void
}

class AtendimentoEmergencia {
  -prioridade : Prioridade
  -status : StatusEmergencia
  +iniciarAvaliacao(ProfissionalSaude profissional) void
  +concluir() void
  +estaAguardando() boolean
  +validar() void
}

class ProcedimentoCirurgico {
  -descricao : String
  -tipoCirurgia : TipoCirurgia
  -observacaoPreOperatoria : String
  -observacaoPosOperatoria : String
  -dataHoraInicio : LocalDateTime
  -dataHoraFim : LocalDateTime
  -status : StatusProcedimento
  +iniciar() void
  +concluir(String observacaoPos) void
  +cancelar() void
  +podeCancelar() boolean
  +validar() void
}

%% ===== Internacao e Quarto =====
class Internacao {
  -id : Long
  -dataEntrada : LocalDateTime
  -dataAlta : LocalDateTime
  -motivo : String
  -observacao : String
  -status : StatusInternacao
  +registrarEntrada(Quarto quarto) void
  +registrarAlta(LocalDateTime dataAlta) void
  +cancelar() void
  +podeCancelar() boolean
  +validar() void
  +transferirQuarto(Quarto novoQuarto) void
  +calcularDiasInternado() long
}

class Quarto {
  -id : Long
  -numero : int
  -andar : int
  -tipo : TipoQuarto
  -capacidade : int
  -ocupacaoAtual : int
  -situacao : SituacaoQuarto
  +possuiVaga() boolean
  +ocupar() void
  +liberar() void
  +colocarEmManutencao() void
}

%% ===== Enumeracoes =====
class StatusConsulta {
  <<enumeration>>
  AGENDADA
  CONFIRMADA
  EM_ATENDIMENTO
  CONCLUIDA
  CANCELADA
  NAO_COMPARECEU
  +podeIrPara(StatusConsulta novo) boolean
}
class StatusEmergencia {
  <<enumeration>>
  AGUARDANDO_AVALIACAO
  EM_ATENDIMENTO
  CONCLUIDO
}
class Prioridade {
  <<enumeration>>
  BAIXA
  MODERADA
  ALTA
  CRITICA
}
class StatusProcedimento {
  <<enumeration>>
  AGENDADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  +podeIrPara(StatusProcedimento novo) boolean
}
class TipoCirurgia {
  <<enumeration>>
  ELETIVA
  URGENCIA
  EMERGENCIA
}
class Especialidade {
  <<enumeration>>
  CARDIOLOGIA
  NEUROLOGIA
  ORTOPEDIA
  PEDIATRIA
  DERMATOLOGIA
  GINECOLOGIA
}
class StatusInternacao {
  <<enumeration>>
  ATIVA
  ALTA
  CANCELADA
}
class TipoQuarto {
  <<enumeration>>
  ENFERMARIA
  APARTAMENTO
  UTI
  ISOLAMENTO
}
class SituacaoQuarto {
  <<enumeration>>
  DISPONIVEL
  OCUPADO
  MANUTENCAO
}
class TipoRegistro {
  <<enumeration>>
  CONSULTA
  EMERGENCIA
  PROCEDIMENTO_CIRURGICO
  INTERNACAO
  ALTA
}

%% ===== Heranca =====
ProfissionalSaude <|-- ClinicoGeral
ProfissionalSaude <|-- MedicoEspecialista
ProfissionalSaude <|-- Cirurgiao
Atendimento <|-- Consulta
Consulta <|-- ConsultaRotina
Consulta <|-- ConsultaEspecializada
Atendimento <|-- AtendimentoEmergencia
Atendimento <|-- ProcedimentoCirurgico

%% ===== Associacoes =====
Paciente "1" *-- "1" Historico : possui
Historico "1" *-- "0..*" RegistroHistorico : contem
Atendimento "0..*" --> "1" Paciente : paciente
Atendimento "0..*" --> "0..1" ProfissionalSaude : responsavel
Cirurgiao "1" o-- "0..*" ProcedimentoCirurgico : realiza
ClinicoGeral "1" --> "0..*" Encaminhamento : emite
Encaminhamento "0..*" --> "1" Paciente : paciente
Internacao "0..*" --> "1" Paciente : paciente
Internacao "0..*" --> "1" Quarto : ocupa
Internacao "0..*" --> "1" ProfissionalSaude : responsavel

%% ===== Realizacao (implementa interface) =====
Validavel <|.. Atendimento
Validavel <|.. Internacao
Cancelavel <|.. Consulta
Cancelavel <|.. ProcedimentoCirurgico
Cancelavel <|.. Internacao

%% ===== Enums ligados as classes que os usam =====
Consulta "0..*" --> "1" StatusConsulta
AtendimentoEmergencia "0..*" --> "1" StatusEmergencia
AtendimentoEmergencia "0..*" --> "1" Prioridade
ProcedimentoCirurgico "0..*" --> "1" StatusProcedimento
ProcedimentoCirurgico "0..*" --> "1" TipoCirurgia
MedicoEspecialista "0..*" --> "1" Especialidade
ConsultaEspecializada "0..*" --> "1" Especialidade
Encaminhamento "0..*" --> "1" Especialidade
Internacao "0..*" --> "1" StatusInternacao
Quarto "0..*" --> "1" TipoQuarto
Quarto "0..*" --> "1" SituacaoQuarto
RegistroHistorico "0..*" --> "1" TipoRegistro
